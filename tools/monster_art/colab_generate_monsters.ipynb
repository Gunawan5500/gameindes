    "# @title Langkah 1 — Cek GPU & Siapkan Program (Tunggu ~1 menit)\n",
    "import subprocess, sys\n",
    "\n",
    "gpu_check = subprocess.run(['nvidia-smi', '--query-gpu=name,memory.total', '--format=csv,noheader'], capture_output=True, text=True)\n",
    "if gpu_check.returncode != 0:\n",
    "    raise RuntimeError(\n",
    "        'GPU BELUM AKTIF! Silakan klik menu atas: Runtime -> Change runtime type -> pilih T4 GPU -> Save, lalu jalankan Langkah 1 lagi.'\n",
    "    )\n",
    "print('GPU aktif:', gpu_check.stdout.strip())\n",
    "print('Sedang menginstall library AI (hanya perlu sekali per sesi)...')\n",
    "!pip install -q --upgrade diffusers transformers accelerate safetensors pillow tqdm\n",
    "print('Langkah 1 SELESAI! Lanjut ke Langkah 2.')"
   ]
