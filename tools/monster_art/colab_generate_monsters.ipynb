      "source": [
        "# @title Langkah 4 — Muat Model AI ke GPU (Tunggu ~1-2 menit)\n",
        "import torch\n",
        "from diffusers import AutoPipelineForText2Image\n",
        "\n",
        "if not torch.cuda.is_available():\n",
        "    raise RuntimeError('CUDA GPU tidak terdeteksi. Pastikan Runtime -> Change runtime type -> T4 GPU sudah aktif.')\n",
        "\n",
        "MODEL_ID = 'stabilityai/sdxl-turbo'\n",
        "print('Sedang memuat model AI (SDXL-Turbo) ke GPU...')\n",
        "\n",
        "pipe = AutoPipelineForText2Image.from_pretrained(\n",
        "    MODEL_ID,\n",
        "    torch_dtype=torch.float16,\n",
        "    variant='fp16',\n",
        ")\n",
        "pipe.to('cuda')\n",
        "pipe.set_progress_bar_config(disable=True)\n",
        "pipe.enable_vae_slicing()\n",
        "print('Model AI SIAP! Lanjut ke Langkah 5.')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "PXmy2TPZZYLM"
      },
      "outputs": [],
      "source": [
        "# @title Langkah 5 — Mulai Generate Gambar! (Otomatis Simpan ke Google Drive)\n",
        "from IPython.display import display\n",
        "from tqdm.auto import tqdm\n",
        "\n",
        "# --- PENGATURAN MUDAH ---\n",
        "# Untuk uji coba awal, biarkan 'Hollowfrost Range' (~1-2 menit).\n",
        "# Jika hasil sudah cocok, HAPUS teksnya hingga kosong ('') untuk generate SEMUA 16 Area!\n",
        "AREA_FILTER = 'Hollowfrost Range'  # @param {type:'string'}\n",
        "BOSS_ONLY = False  # @param {type:'boolean'}\n",
        "LIMIT = 0  # @param {type:'integer'}\n",
        "NUM_STEPS = 4  # @param {type:'slider', min:2, max:8, step:1}\n",
        "# 'auto' otomatis menyimpan 512x512 untuk monsters & 256x256 untuk materials/trophies:\n",
        "SAVE_SIZE = 'auto'  # @param ['auto', '256', '512']\n",
        "WEBP_QUALITY = 85  # @param {type:'slider', min:60, max:95, step:5}\n",
        "SHOW_PREVIEW_EVERY = 10  # @param {type:'integer'}\n",
        "OVERWRITE = False  # @param {type:'boolean'}\n",
        "\n",
        "target_px = (512 if ASSET_PACK == 'monsters' else 256) if SAVE_SIZE == 'auto' else int(SAVE_SIZE)\n",
        "\n",
        "selected = entries\n",
        "if AREA_FILTER.strip():\n",
        "    selected = [e for e in selected if e['area'].lower() == AREA_FILTER.strip().lower()]\n",
        "if BOSS_ONLY:\n",
        "    selected = [e for e in selected if e['tipe'] in ('Boss', 'Mini Boss')]\n",
        "\n",
        "remaining = [e for e in selected if OVERWRITE or not (OUT_DIR / e['filename']).exists()]\n",
        "print(f'Target terpilih: {len(selected)} | Sudah ada (dilewati): {len(selected) - len(remaining)} | Akan dibuat sekarang: {len(remaining)}')\n",
        "print(f'Ukuran simpan  : {target_px}x{target_px} px (.webp)')\n",
        "\n",
        "generated = 0\n",
        "skipped = 0\n",
        "\n",
        "for entry in tqdm(selected, desc=f'Generating {ASSET_PACK}'):\n",
        "    dest = OUT_DIR / entry['filename']\n",
        "    if dest.exists() and not OVERWRITE:\n",
        "        skipped += 1\n",
        "        continue\n",
        "    if LIMIT > 0 and generated >= LIMIT:\n",
        "        break\n",
        "\n",
        "    dest.parent.mkdir(parents=True, exist_ok=True)\n",
        "    gen = torch.Generator(device='cuda').manual_seed(int(entry['seed']))\n",
        "\n",
        "    image = pipe(\n",
        "        prompt=entry['prompt'],\n",
        "        num_inference_steps=NUM_STEPS,\n",
        "        guidance_scale=0.0,\n",
        "        width=512,\n",
        "        height=512,\n",
        "        generator=gen,\n",
        "    ).images[0]\n",
        "\n",
        "    out_img = image.resize((target_px, target_px)) if target_px != 512 else image\n",
        "    out_img.save(dest, format='WEBP', quality=WEBP_QUALITY, method=6)\n",
        "    generated += 1\n",
        "\n",
        "    if SHOW_PREVIEW_EVERY > 0 and (generated == 1 or generated % SHOW_PREVIEW_EVERY == 0):\n",
        "        print(f\"\\nPreview #{generated}: {entry['display_name']} ({entry['area']} - {entry['tipe']})\")\n",
        "        display(image.resize((220, 220)))\n",
        "\n",
        "print(f'\\nLangkah 5 SELESAI! Baru dibuat: {generated} | Dilewati (sudah ada): {skipped}')\n",
        "print('Semua gambar tersimpan aman di Google Drive Anda:', OUT_DIR)"
      ]
    },
