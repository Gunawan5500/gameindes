   "source": [
    "# @title Langkah 2 — Pilih Jenis Gambar & Hubungkan ke Google Drive\n",
    "from pathlib import Path\n",
    "from google.colab import drive\n",
    "\n",
    "# Pilih paket yang mau dibuat gambarnya:\n",
    "ASSET_PACK = 'monsters'  # @param ['monsters', 'materials', 'trophies']\n",
    "\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "DRIVE_BASE = Path('/content/drive/MyDrive/BattleSmith_GameArt')\n",
    "OUT_DIR = DRIVE_BASE / ASSET_PACK\n",
    "MANIFEST_PATH = DRIVE_BASE / f'{ASSET_PACK}_visual_manifest.json'\n",
    "\n",
    "OUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "print('Google Drive terhubung!')\n",
    "print('Paket dipilih :', ASSET_PACK)\n",
    "print('Folder hasil  :', OUT_DIR)\n",
    "print('Langkah 2 SELESAI! Lanjut ke Langkah 3.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# @title Langkah 3 — Unduh Daftar Prompt Otomatis dari GitHub Repo Anda\n",
    "import json\n",
    "import urllib.request\n",
    "from google.colab import files\n",
    "\n",
    "REFRESH_FROM_GITHUB = False  # @param {type:'boolean'}\n",
    "GITHUB_RAW_URL = f'https://raw.githubusercontent.com/Gunawan5500/gameindes/main/data/{ASSET_PACK}_visual_manifest.json'\n",
    "\n",
    "if REFRESH_FROM_GITHUB or not MANIFEST_PATH.exists():\n",
    "    print('Mengunduh daftar prompt terbaru dari GitHub:', GITHUB_RAW_URL)\n",
    "    try:\n",
    "        urllib.request.urlretrieve(GITHUB_RAW_URL, MANIFEST_PATH)\n",
    "        print('Berhasil diunduh & disimpan ke Google Drive:', MANIFEST_PATH)\n",
    "    except Exception as e:\n",
    "        print('Gagal unduh otomatis dari GitHub:', e)\n",
    "        print(f'Silakan upload manual file {MANIFEST_PATH.name} dari komputer Anda:')\n",
    "        uploaded = files.upload()\n",
    "        first_name = next(iter(uploaded.keys()))\n",
    "        MANIFEST_PATH.write_bytes(uploaded[first_name])\n",
    "\n",
    "manifest = json.loads(MANIFEST_PATH.read_text(encoding='utf-8'))\n",
    "entries = manifest['entries']\n",
    "existing_count = sum(1 for e in entries if (OUT_DIR / e['filename']).exists())\n",
    "\n",
    "print(f\"Paket       : {ASSET_PACK} (Gaya: {manifest['style']})\")\n",
    "print(f\"Total target: {len(entries)} gambar | Sudah jadi di Drive: {existing_count} | Sisa: {len(entries) - existing_count}\")\n",
    "print('Daftar Area :', sorted(set(e['area'] for e in entries)))\n",
    "print('Langkah 3 SELESAI! Lanjut ke Langkah 4.')"
   ]
