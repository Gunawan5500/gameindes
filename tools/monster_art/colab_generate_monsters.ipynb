    "# @title Langkah 6 — Bungkus Semua Gambar Jadi 1 File ZIP (Siap Download)\n",
    "import shutil\n",
    "\n",
    "zip_base = DRIVE_BASE / f'battle_smith_{ASSET_PACK}_art'\n",
    "zip_file = shutil.make_archive(str(zip_base), 'zip', root_dir=OUT_DIR)\n",
    "count = sum(1 for _ in OUT_DIR.rglob('*.webp'))\n",
    "print(f'Total file .webp di dalam ZIP ({ASSET_PACK}): {count}')\n",
    "print(f'File ZIP siap diunduh dari Google Drive Anda: {zip_file}')\n",
