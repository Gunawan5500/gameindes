      "thrust":    { "up": 4, "left": 5, "down": 6, "right": 7 },
      "walk":      { "up": 8, "left": 9, "down": 10, "right": 11 },
      "slash":     { "up": 12, "left": 13, "down": 14, "right": 15 },
      "shoot":     { "up": 16, "left": 17, "down": 18, "right": 19 }
    }
  },
